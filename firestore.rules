rules_version = '2';
// Each signed-in user can read and write only their own document. Nothing else is accessible.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /watched/{bucket} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
