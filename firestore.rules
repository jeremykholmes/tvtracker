rules_version = '2';
// Each signed-in user can read and write their own document. An owner can also make logins for other
// people (listed by account id in users/{uid}.logins) with access to their shows and checkmarks:
// role 'view' can only look; role 'edit' can also make changes.
// Only the owner can change who has access, their profile, or delete the account's data.
// The site admin (one verified email address, below) can also read every account, for the Admin page.
// Anyone can send a Contact us message (messages/{id}); only the admin can read or delete them.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function logins(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.get('logins', {}); }
    function isMember(uid) { return signedIn() && request.auth.uid in logins(uid); }
    function isAdmin() { return signedIn() && request.auth.token.email == 'jeremykholmes@gmail.com' && request.auth.token.email_verified == true; }
    function isEditor(uid) { return isMember(uid) && logins(uid)[request.auth.uid].get('role', 'edit') == 'edit'; }

    match /users/{uid} {
      allow get: if isOwner(uid) || isMember(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, delete: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isEditor(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['logins', 'members', 'profile']));
      match /watched/{bucket} {
        allow read: if isOwner(uid) || isMember(uid);
        allow write: if isOwner(uid) || isEditor(uid);
      }
    }

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 't', 'uid'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && (request.resource.data.uid == '' || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, delete: if isAdmin();
    }
  }
}
